{
  "name": "opentutor-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "predev": "node ./scripts/copy-pdfjs-assets.mjs",
    "build": "node ./scripts/build.mjs",
    "preview": "vite preview",
    "start": "node ./scripts/start-all.mjs",
    "lint": "oxlint app components context features hooks lib shared src",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test:node": "node ./scripts/run-node-tests.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "contracts:generate": "node ./scripts/generate-contracts.mjs",
    "contracts:check": "node ./scripts/generate-contracts.mjs --check",
    "check:fast": "bun run contracts:check && bun run architecture:check && bun run typecheck && bun run test:node && bun run test:unit && bun run lint",
    "check": "bun run check:fast && bun run build && bun run perf:check",
    "perf:check": "node ./scripts/route_budgets.mjs",
    "build:perf": "bun run build && bun run perf:check",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs src app components context contracts features hooks lib shared",
    "audit": "playwright test --project=ui-audit",
    "audit:ui": "playwright test --ui --project=ui-audit",
    "audit:report": "playwright show-report",
    "test:e2e:critical": "playwright test --project=critical-turns",
    "test:e2e:multi-worker": "playwright test --project=multi-worker-turns-desktop --project=multi-worker-turns-mobile",
    "build:brand-icons": "tsx ./scripts/build-brand-icons.mts",
    "sync:logo": "node ./scripts/sync-logo-assets.mjs",
    "openui:generate": "openui generate lib/openui/library.ts --spec --out lib/openui/generated/spec.json",
    "openui:prompt": "openui generate lib/openui/library.ts --out lib/openui/generated/system-prompt.txt --prompt-options promptOptions && openui generate lib/openui/library.ts --out lib/openui/generated/dashboard-system-prompt.txt --prompt-options dashboardPromptOptions && rm -f lib/openui/generated/*system-prompt.spec.json && node ./scripts/compact-openui-prompt.mjs --sync-backend"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/math-block": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@hyperframes/player": "0.9.40",
    "@openuidev/intelligent-ui-library": "^0.0.2",
    "@openuidev/lang-core": "^1.1.1",
    "@openuidev/react-lang": "^1.1.1",
    "@openuidev/react-ui": "^0.18.9",
    "@recogito/text-annotator": "4.2.5",
    "@tanstack/react-router": "^1.170.46",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx-preview": "^0.3.7",
    "epubjs": "^0.3.93",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.24.0",
    "jspdf": "^4.2.0",
    "katex": "0.16.27",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^6.19.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mermaid": "^11.14.0",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tokenizers": "^0.23.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.9.12"
    }
  },
  "devDependencies": {
    "@openuidev/cli": "^0.6.3",
    "@playwright/test": "^1.53.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.94.0",
    "postcss": "^8",
    "simple-icons": "^16.27.1",
    "tailwindcss": "^3.4.17",
    "tsrs": "^7.1.0-beta.tsrs3",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  }
}
